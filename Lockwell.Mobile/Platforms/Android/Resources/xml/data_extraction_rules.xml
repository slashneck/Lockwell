<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+ replacement for fullBackupContent.

    Both cloud backup and device-to-device transfer are refused outright. A vault must
    only ever leave this device through Lockwell's own paired-device sync, where the
    user chose each item and the receiving device re-encrypts under its own key.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
