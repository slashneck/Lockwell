<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Lockwell's Android companion.

		Android only, deliberately. iOS is out of scope (sideloading is too painful) and
		a Windows head would just be a worse version of the real desktop app.
	-->
	<PropertyGroup>
		<TargetFrameworks>net8.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Lockwell.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>Lockwell</ApplicationTitle>
		<ApplicationId>com.lockwell.vault</ApplicationId>

		<ApplicationDisplayVersion>1.2.0</ApplicationDisplayVersion>
		<!--
			ApplicationVersion is Android's versionCode. It must only ever increase:
			Android refuses to install a package whose versionCode is lower than the
			one already on the device.
		-->
		<ApplicationVersion>2</ApplicationVersion>

		<!--
			Android 9. The platform BiometricPrompt arrived in API 28, and Keystore
			guarantees below that are patchy anyway. Android 9 shipped in 2018, so this
			costs almost no real-world coverage.
		-->
		<SupportedOSPlatformVersion>28.0</SupportedOSPlatformVersion>

		<!--
			Put the managed assemblies inside the APK instead of relying on Fast
			Deployment, which pushes them to the device as a separate step. Without this
			an APK installed with `adb install` starts and immediately aborts looking for
			assemblies that were never pushed. Costs a little deploy speed and makes the
			APK behave the same way everywhere, which is what we actually want to ship.
		-->
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#06080D" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#06080D" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />

		<!--
			Google's own AndroidX biometric library, packaged for .NET. Used to drive
			BiometricPrompt and, more importantly, to bind a hardware-backed Keystore key
			to a successful fingerprint or face check.
		-->
		<!--
			No biometric package. Android has had BiometricPrompt built in since API 28,
			so the platform API is used directly. The AndroidX compatibility library
			exists for older devices but drags in Kotlin extension packages that collide
			with the ones MAUI already ships, and a fingerprint prompt is not worth
			adding a dependency conflict to a security product over.
		-->
	</ItemGroup>

	<ItemGroup>
		<!-- The identical Argon2id and AES-256-GCM the desktop app uses. -->
		<ProjectReference Include="..\Lockwell.Core\Lockwell.Core.csproj" />
	</ItemGroup>

</Project>
