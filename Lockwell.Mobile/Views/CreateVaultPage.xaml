<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lockwell.Mobile.Views.CreateVaultPage"
             BackgroundColor="{StaticResource Bg0}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,24,24,40" Spacing="0">

            <Label Text="Create a vault" Style="{StaticResource H1}" />
            <Label Text="Each vault has its own password and its own key. Opening one never opens another."
                   Style="{StaticResource Caption}" Margin="0,6,0,0" />

            <Label Text="NAME" Style="{StaticResource Overline}" Margin="2,26,0,8" />
            <Border Style="{StaticResource InputField}">
                <Entry x:Name="NameEntry" Style="{StaticResource InputEntry}"
                       Placeholder="e.g. Personal" />
            </Border>

            <Label Text="ICON" Style="{StaticResource Overline}" Margin="2,20,0,8" />
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="GlyphRow" Spacing="8" />
            </ScrollView>

            <Label Text="PASSWORD" Style="{StaticResource Overline}" Margin="2,22,0,8" />
            <Border Style="{StaticResource InputField}">
                <Entry x:Name="PasswordEntry" Style="{StaticResource InputEntry}"
                       IsPassword="True" Placeholder="At least 10 characters"
                       TextChanged="OnPasswordChanged" />
            </Border>
            <Label x:Name="StrengthLabel" Style="{StaticResource Caption}" FontSize="11"
                   Margin="2,7,0,0"
                   Text="A few unrelated words is stronger than symbols." />

            <Label Text="CONFIRM" Style="{StaticResource Overline}" Margin="2,18,0,8" />
            <Border Style="{StaticResource InputField}">
                <Entry x:Name="ConfirmEntry" Style="{StaticResource InputEntry}"
                       IsPassword="True" Placeholder="Type it again" />
            </Border>

            <Border Style="{StaticResource Card}" BackgroundColor="#1A1508"
                    Stroke="{StaticResource Warning}" Margin="0,22,0,0" Padding="14,12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="There is no way to reset this" FontSize="13"
                           FontAttributes="Bold" TextColor="{StaticResource TextColor}" />
                    <Label Text="Lockwell has no backdoor and no account to recover from. Forget this password and whatever is in this vault is gone."
                           Style="{StaticResource Caption}" FontSize="11" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="CreateButton" Text="Create vault"
                    Style="{StaticResource AccentButton}"
                    Margin="0,20,0,0" Clicked="OnCreateClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
