<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Palette ============================ -->
    <!-- Premium dark: near-black depth, glass surfaces, teal+indigo accents. -->
    <Color x:Key="Bg0Color">#06080D</Color>
    <Color x:Key="Bg1Color">#0A0E16</Color>
    <Color x:Key="Bg2Color">#11151F</Color>
    <Color x:Key="Bg3Color">#1A2030</Color>
    <Color x:Key="StrokeColor">#22293A</Color>
    <Color x:Key="AccentColor">#2DD4BF</Color>
    <Color x:Key="Accent2Color">#38BDF8</Color>
    <Color x:Key="VioletColor">#8B5CF6</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#FB7185</Color>
    <Color x:Key="TextColor">#EAF1F8</Color>
    <Color x:Key="MutedColor">#8694A8</Color>
    <!-- A step dimmer than Muted, for detail that should be readable but never lead:
         key fingerprints, adapter names, secondary metadata. -->
    <Color x:Key="FaintColor">#5C6A7E</Color>

    <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Accent2" Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="Violet" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===================== Gradients & glass ===================== -->
    <!-- Window ambient background -->
    <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#070A11" Offset="0" />
        <GradientStop Color="#05070C" Offset="1" />
    </LinearGradientBrush>

    <!-- Accent gradient (teal -> cyan) for primary actions -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2DD4BF" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentBrushHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#45E2CE" Offset="0" />
        <GradientStop Color="#43DDF5" Offset="1" />
    </LinearGradientBrush>

    <!-- Hero gradient for big titles (teal -> indigo -> violet) -->
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,0.4">
        <GradientStop Color="#5EEAD4" Offset="0" />
        <GradientStop Color="#7DD3FC" Offset="0.5" />
        <GradientStop Color="#A78BFA" Offset="1" />
    </LinearGradientBrush>

    <!-- Frosted glass surface and hairline border -->
    <LinearGradientBrush x:Key="GlassBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14FFFFFF" Offset="0" />
        <GradientStop Color="#06FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#30FFFFFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Hero card surface. Mostly opaque so the card reads as raised against the ambient
         glow without needing a shadow behind it, and so the corner blooms tint it rather
         than shine through it. -->
    <LinearGradientBrush x:Key="HeroCardBg" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#E6121826" Offset="0" />
        <GradientStop Color="#E60C111B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroCardStroke" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3DFFFFFF" Offset="0" />
        <GradientStop Color="#12FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Ambient corner glows -->
    <RadialGradientBrush x:Key="GlowTeal" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#382DD4BF" Offset="0" />
        <GradientStop Color="#002DD4BF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowViolet" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#388B5CF6" Offset="0" />
        <GradientStop Color="#008B5CF6" Offset="1" />
    </RadialGradientBrush>

    <!-- ===================== Effects ===================== -->
    <DropShadowEffect x:Key="SoftShadow" Color="#000000" BlurRadius="34" ShadowDepth="12" Direction="270" Opacity="0.55" />
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="22" ShadowDepth="7" Direction="270" Opacity="0.40" />
    <DropShadowEffect x:Key="AccentGlow" Color="#2DD4BF" BlurRadius="26" ShadowDepth="0" Opacity="0.50" />
    <DropShadowEffect x:Key="AccentGlowSoft" Color="#2DD4BF" BlurRadius="18" ShadowDepth="0" Opacity="0.30" />

    <!-- ============================ Text ============================ -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <!--
      Hero is the brand voice: the teal-to-violet gradient, reserved for the wordmark and
      the landing screen. It used to be the default treatment for every title in the app,
      including each entry's own name, and a gradient that appears everywhere stops
      reading as the brand and starts reading as the colour titles happen to be. Page and
      item titles use PageTitle.
    -->
    <Style x:Key="Hero" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource HeroBrush}" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="Overline" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <!-- ============================ Focus ============================ -->
    <!--
      Every templated control below draws its own keyboard-focus state, so the stock
      dotted rectangle is turned off rather than layered on top of it.

      This matters more than it sounds: nothing in the app showed focus except that dotted
      rectangle, and on a custom-drawn button a dotted rectangle does not read as "you are
      here", it reads as a rendering fault. Tabbing through a dialog looked like the app
      had lost track of where you were.
    -->

    <!-- ============================ Buttons ============================ -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#04231F" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="glow" CornerRadius="12" Background="{StaticResource AccentBrush}"
                                Effect="{StaticResource AccentGlow}" />
                        <Border x:Name="bd" CornerRadius="12" Background="{StaticResource AccentBrush}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrushHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrushHover}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                            <Setter TargetName="glow" Property="Effect" Value="{x:Null}" />
                            <Setter TargetName="glow" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="12" Background="{StaticResource GlassBg}"
                            BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover lifts the border and the fill. It used to add a glow, but
                             an Effect drags the label through an intermediate bitmap, so the
                             text went soft the moment the pointer touched it. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="bd" Property="Background" Value="#1E2DD4BF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="bd" Property="Background" Value="#2E2DD4BF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8" Background="Transparent"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title-bar close. Same shape as IconButton, but it goes red under the pointer,
         which is the one convention every Windows user already has. Losing an unlocked
         vault to a misread icon is a worse outcome than losing a browser tab. -->
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8" Background="Transparent"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E03A4A" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Accent2}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="lbl" Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="lbl" Property="TextDecorations" Value="Underline" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Inputs ============================ -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="11" Background="#0A0E17"
                            BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#38FFFFFF" />
                        </Trigger>
                        <!-- No glow on focus. This border wraps PART_ContentHost, so an
                             Effect here resampled the text as it was being typed. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="bd" Property="Background" Value="#0D1322" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InputPassword" TargetType="PasswordBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" CornerRadius="11" Background="#0A0E17"
                            BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#38FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="bd" Property="Background" Value="#0D1322" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Cards ============================ -->
    <!-- Glass card: frosted gradient surface, hairline border, soft shadow. -->
    <!--
      No drop shadow here, and that is the point.

      In WPF an Effect on an element forces its whole subtree into an intermediate bitmap
      before compositing. Text rendered that way loses ClearType and gets resampled, which
      is why every label inside a card looked soft while the same font was crisp in the
      title bar. Cards are everywhere, so this made the entire app look slightly out of
      focus.

      On a near-black background a black shadow was contributing almost nothing visually
      anyway. Depth now comes from the border and the fill, which cost nothing and keep
      text sharp. Shadows are still available for things that hold no text.
    -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!--
      Hero card: the lifted surface used by the unlock screen, the profile gate and every
      dialog.

      It used to carry SoftShadow, which is the same mistake that was fixed on Card above
      and it was worse here, for a reason worth writing down. An Effect renders the whole
      subtree to a bitmap and then casts the shadow from *that bitmap's alpha*. A card
      whose own fill is white at 2-8% has almost no alpha of its own, so the silhouette
      being shadowed was not the card at all. It was the text and the controls inside it:
      every title, every field row and the Unlock button carried its own black smear,
      and all of that text was resampled without ClearType on the way through.

      So the shadow is gone and the fill does the work instead. A card that is genuinely
      darker than the backdrop reads as raised on its own, and it stays sharp. Sites that
      sit over a dimmed overlay set their own near-opaque Background and override this.
    -->
    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{StaticResource HeroCardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource HeroCardStroke}" />
    </Style>

    <!-- ============================ CheckBox ============================ -->
    <!--
      A default style, with no key, so every checkbox already in the app picks it up.

      There was no checkbox style at all before this, which meant the stock Aero control:
      a white square with a black tick, on settings, the create-vault screen, the
      preflight gate, the unlock risk gate, the Devices rules and the compress dialog. It
      was the one control in the app that looked like it came from somewhere else.
    -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Grid.Column="0" Width="19" Height="19" CornerRadius="6"
                                Background="#0A0E17" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                       FontSize="11" Foreground="#04231F" Opacity="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter x:Name="label" Grid.Column="1" Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="tick" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- Indeterminate is unused today, but a checkbox that silently
                             looked unchecked in that state would be a quiet lie. -->
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="tick" Property="Text" Value="&#xE738;" />
                            <Setter TargetName="tick" Property="Foreground" Value="{StaticResource Accent}" />
                            <Setter TargetName="tick" Property="Opacity" Value="1" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="box" Property="Background" Value="#242DD4BF" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrushHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                            <Setter TargetName="box" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ ToolTip ============================ -->
    <!-- 46 of these across the app, every one of them the pale system tooltip. -->
    <Style TargetType="ToolTip">
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border CornerRadius="8" Background="#F2151B28"
                            BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            Padding="10,7">
                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Media seek slider ============================ -->
    <Style x:Key="MediaSeekRepeatButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MediaSeekDecreaseRepeat" TargetType="RepeatButton" BasedOn="{StaticResource MediaSeekRepeatButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="5" CornerRadius="2.5" Background="{StaticResource Accent}" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MediaSeekSlider" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Border Height="5" CornerRadius="2.5" VerticalAlignment="Center"
                                Background="#22FFFFFF" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource MediaSeekDecreaseRepeat}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource MediaSeekRepeatButton}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" VerticalAlignment="Center">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource Text}" Stroke="{StaticResource Accent}" StrokeThickness="2">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#2DD4BF" BlurRadius="10" ShadowDepth="0" Opacity="0.35" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ ScrollBar (slim) ============================ -->
    <!--
      Two things were wrong with the old one. It hard-coded a vertical Track, so a
      horizontal scrollbar rendered as a vertical smear; and the thumb ran edge to edge
      with no inset, which is why the settings dialog looked like it had a loose bar
      floating over its content. The thumb is now inset inside a faint gutter and
      brightens under the pointer, and Orientation picks the right layout.
    -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="tb" CornerRadius="3" Background="#2A3244" Margin="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tb" Property="Background" Value="#3C4762" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="tb" Property="Background" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The page-up / page-down halves of the track. Invisible, but they must still be
         hit-testable or clicking the gutter does nothing. -->
    <Style x:Key="ScrollTrackPiece" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrackPiece}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrackPiece}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollTrackPiece}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollTrackPiece}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
