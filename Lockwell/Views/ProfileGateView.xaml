<UserControl x:Class="Lockwell.Views.ProfileGateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border x:Name="Card" Style="{StaticResource HeroCard}" Width="460"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36" ClipToBounds="False">
            <StackPanel>
                <Border Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Center"
                        Background="{StaticResource GlassBg}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1"
                        Effect="{StaticResource AccentGlowSoft}">
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="28"
                               Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Choose a profile" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="Each profile is a separate encrypted vault with its own password."
                           Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />

                <ListBox x:Name="ProfileList" Margin="0,22,0,0" MinHeight="120" MaxHeight="220"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Margin" Value="0,4" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="12" Padding="14,12"
                                                Background="#120E1218" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Text}" />
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                               Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter TargetName="bd" Property="Background" Value="#182DD4BF" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1A2030" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Margin="0,18,0,0">
                    <Button x:Name="ContinueButton" Style="{StaticResource AccentButton}" Content="Continue"
                            Height="42" HorizontalAlignment="Stretch" Click="Continue_Click" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AddProfileButton" Grid.Column="0" Style="{StaticResource GhostButton}"
                                Content="Add profile" Height="42" HorizontalAlignment="Stretch"
                                Click="AddProfile_Click" />
                        <Button x:Name="ImportBackupButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                                Content="Import backup" Height="42" HorizontalAlignment="Stretch"
                                Click="ImportBackup_Click" />
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button x:Name="RenameProfileButton" Style="{StaticResource LinkButton}" Content="Rename selected"
                            Click="RenameProfile_Click" />
                    <TextBlock Text=" · " Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <Button x:Name="DeleteProfileButton" Style="{StaticResource LinkButton}" Content="Delete selected"
                            Click="DeleteProfile_Click" Visibility="Collapsed" />
                </StackPanel>

                <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" Foreground="{StaticResource Danger}"
                           HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="360" />
            </StackPanel>
        </Border>

        <Grid x:Name="ProfilePromptOverlay" Visibility="Collapsed" Background="#CC04060B">
            <Border Style="{StaticResource HeroCard}" Width="420" MaxWidth="420" Padding="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Background="#F20C111B">
                <StackPanel>
                    <TextBlock x:Name="PromptTitle" Style="{StaticResource H2}" Text="New profile" />
                    <TextBlock x:Name="PromptSubtitle" Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Pick a name you will recognize on this device." TextWrapping="Wrap" />
                    <TextBlock Text="Profile name" Style="{StaticResource Caption}" Margin="0,18,0,6" />
                    <TextBox x:Name="PromptInput" Style="{StaticResource InputBox}" Height="42"
                             KeyDown="PromptInput_KeyDown" />
                    <Grid Margin="0,22,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Cancel" MinWidth="110" Height="40"
                                HorizontalAlignment="Left" Click="PromptCancel_Click" />
                        <Button x:Name="PromptConfirmButton" Style="{StaticResource AccentButton}" Content="Create"
                                MinWidth="120" Height="40" HorizontalAlignment="Right" Click="PromptConfirm_Click" />
                    </Grid>
                    <Button x:Name="PromptImportLink" Style="{StaticResource LinkButton}" Content="Import from backup instead"
                            HorizontalAlignment="Center" Margin="0,14,0,0" Click="PromptImportLink_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ImportOverlay" Visibility="Collapsed" Background="#CC04060B">
            <Border Style="{StaticResource HeroCard}" Width="420" MaxWidth="420" Padding="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Background="#F20C111B">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Import backup" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Restore an encrypted backup ZIP into a profile on this device."
                               TextWrapping="Wrap" />
                    <TextBlock Text="Profile name" Style="{StaticResource Caption}" Margin="0,18,0,6" />
                    <TextBox x:Name="ImportProfileName" Style="{StaticResource InputBox}" Height="42"
                             KeyDown="ImportInput_KeyDown" />
                    <TextBlock Text="Backup master password" Style="{StaticResource Caption}" Margin="0,14,0,6" />
                    <PasswordBox x:Name="ImportPassword" Style="{StaticResource InputPassword}" Height="42"
                                 KeyDown="ImportInput_KeyDown" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Text="Use the master password from when this backup was exported."
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ImportErrorText" Style="{StaticResource Caption}" Foreground="{StaticResource Danger}"
                               Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                    <Grid Margin="0,22,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Cancel" MinWidth="110" Height="40"
                                HorizontalAlignment="Left" Click="ImportCancel_Click" />
                        <Button x:Name="ImportConfirmButton" Style="{StaticResource AccentButton}" Content="Import"
                                MinWidth="120" Height="40" HorizontalAlignment="Right" Click="ImportConfirm_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
