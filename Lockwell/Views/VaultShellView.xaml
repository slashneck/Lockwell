<UserControl x:Class="Lockwell.Views.VaultShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RowEntrance" TargetType="ListBoxItem">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="14" /></Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.32">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="0" Duration="0:0:0.32">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ShellRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border x:Name="SidebarPanel" Grid.Column="0" Background="#D4090C14"
                BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <Grid Margin="14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="HomeButton" Grid.Row="0" Margin="0,0,0,20" Padding="4,6" CornerRadius="12"
                        Background="Transparent" Cursor="Hand" ToolTip="Home"
                        MouseLeftButtonUp="HomeButton_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#14FFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource GlassBg}"
                                BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="19"
                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Lockwell" FontSize="18" FontWeight="Bold" Foreground="{StaticResource HeroBrush}" />
                            <TextBlock Text="Private vault" Style="{StaticResource Caption}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,14" Background="#120E1218">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ENTRIES" Style="{StaticResource Overline}" FontSize="10" />
                            <TextBlock x:Name="StatEntries" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SECURE" Style="{StaticResource Overline}" FontSize="10" />
                            <TextBlock Text="AES-256" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2" Text="SECTIONS" Style="{StaticResource Overline}" Margin="6,0,0,8" />

                <ListBox Grid.Row="3" x:Name="CategoryList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="CategoryList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="12" Padding="10,10" Background="Transparent"
                                                BorderThickness="1" BorderBrush="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="indicator" Grid.Column="0" Width="3" Height="22" CornerRadius="2"
                                                        Background="{StaticResource AccentBrush}" Margin="0,0,10,0" Visibility="Hidden" />
                                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="9" Background="#180A1218">
                                                    <TextBlock x:Name="catGlyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                               FontSize="14" Foreground="{StaticResource Muted}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="10,0,0,0" FontSize="13"
                                                           Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{Binding CountLabel}" FontSize="11" Foreground="{StaticResource Muted}"
                                                           VerticalAlignment="Center" Margin="6,0,2,0" />

                                                <!-- Fold arrow, only on the "Your sections" divider. -->
                                                <TextBlock x:Name="fold" Grid.Column="3" Text="&#xE70D;"
                                                           FontFamily="{StaticResource IconFont}" FontSize="9"
                                                           Foreground="{StaticResource Faint}" Visibility="Collapsed"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Margin="0,0,2,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!--
                                                The divider above user-made sections. It lives in the same list so
                                                selection stays in one place, but it must not look or behave like a
                                                section: no icon chip, no count, smaller and quieter text.
                                            -->
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter TargetName="catGlyph" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="fold" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="bd" Property="Padding" Value="10,12,10,4" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                <Setter TargetName="fold" Property="Text" Value="&#xE70E;" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#120E1218" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#182DD4BF" />
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#402DD4BF" />
                                                <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="catGlyph" Property="Foreground" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Button Grid.Row="4" Style="{StaticResource GhostButton}" Height="38" Content="+ New section"
                        Margin="0,10,0,0" Click="AddCategory_Click" />

                <StackPanel Grid.Row="5" Margin="0,12,0,0">
                    <!-- Devices sits with Lock and Settings because it is vault-wide,
                         not one of the content sections above. -->
                    <Button x:Name="DevicesButton" Style="{StaticResource GhostButton}" Height="40"
                            Margin="0,0,0,8" Click="Devices_Click"
                            HorizontalContentAlignment="Stretch">
                        <!-- Columns rather than two overlapping children in one cell. The
                             label used to be clipped to "Devi" the moment the count badge
                             appeared, because both were laid out in the same space. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE975;" FontFamily="{StaticResource IconFont}"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="Devices" VerticalAlignment="Center" />

                            <Border x:Name="DeviceCountBadge" Grid.Column="2" VerticalAlignment="Center"
                                    CornerRadius="999" Padding="8,2" Background="{StaticResource Bg3}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="DeviceCountText" FontSize="10"
                                           Foreground="{StaticResource Accent}" Text="0" />
                            </Border>
                        </Grid>
                    </Button>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource GhostButton}" Height="40" Content="Lock" Click="Lock_Click" />

                        <!-- Settings carries the update marker. A found update is worth
                             knowing about but never worth interrupting someone who just
                             opened their vault, so it waits here instead of arriving as
                             a dialog. -->
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="40"
                                Click="Settings_Click" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <TextBlock Text="Settings" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <Border x:Name="UpdateBadge" Visibility="Collapsed"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        CornerRadius="999" Padding="7,2" Background="#242DD4BF"
                                        BorderBrush="{StaticResource Accent}" BorderThickness="1">
                                    <TextBlock x:Name="UpdateBadgeText" FontSize="10"
                                               Foreground="{StaticResource Accent}" Text="" />
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Main workspace ============ -->
        <Grid x:Name="MainWorkspace" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Home ============ -->
            <Grid x:Name="HomePanel" Grid.ColumnSpan="2" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">

                    <Border Width="76" Height="76" CornerRadius="24" HorizontalAlignment="Center"
                            Background="{StaticResource GlassBg}" BorderBrush="{StaticResource GlassStroke}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                   Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Lockwell" FontSize="46" FontWeight="Bold"
                               Foreground="{StaticResource HeroBrush}"
                               HorizontalAlignment="Center" Margin="0,26,0,0" />
                    <TextBlock Text="Your local vault storage" Style="{StaticResource Caption}"
                               FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" />

                    <TextBlock x:Name="HomeVaultName" Text="Vault" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" HorizontalAlignment="Center"
                               Margin="0,18,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420" />

                    <UniformGrid Columns="3" Margin="0,32,0,0">
                        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,8,0" Background="#120E1218">
                            <StackPanel>
                                <TextBlock Text="ITEMS" Style="{StaticResource Overline}" FontSize="10" />
                                <TextBlock x:Name="HomeItemCount" Text="0" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource Text}" Margin="0,4,0,0" />
                                <TextBlock x:Name="HomeItemDetail" Style="{StaticResource Caption}" FontSize="11"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="18,16" Margin="4,0,4,0" Background="#120E1218">
                            <StackPanel>
                                <TextBlock Text="MEDIA" Style="{StaticResource Overline}" FontSize="10" />
                                <TextBlock x:Name="HomeMediaCount" Text="0" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource Text}" Margin="0,4,0,0" />
                                <TextBlock x:Name="HomeMediaDetail" Style="{StaticResource Caption}" FontSize="11"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="18,16" Margin="8,0,0,0" Background="#120E1218"
                                Cursor="Hand" ToolTip="See what is using space"
                                MouseLeftButtonUp="HomeStorage_Click">
                            <StackPanel>
                                <TextBlock Text="ON DISK" Style="{StaticResource Overline}" FontSize="10" />
                                <TextBlock x:Name="HomeVaultSize" Text="0 KB" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource Text}" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="breakdown" Style="{StaticResource Caption}" FontSize="11"
                                               Foreground="{StaticResource Accent}" />
                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                               Margin="4,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border x:Name="HomeBackupCard" Style="{StaticResource Card}" Padding="16,13" Margin="0,12,0,0"
                            Background="#120E1218">
                        <!-- Columns rather than overlaid alignments, so the caption can
                             never run underneath the button. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HomeBackupIcon" Grid.Column="0" Text="&#xE896;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="15" Foreground="{StaticResource Accent}"
                                       VerticalAlignment="Center" Margin="0,0,11,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock x:Name="HomeBackupTitle" Text="Last backup" FontSize="13"
                                           Foreground="{StaticResource Text}" />
                                <TextBlock x:Name="HomeBackupDetail" Style="{StaticResource Caption}"
                                           FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Export now"
                                    Height="32" MinWidth="100" Padding="12,0" FontSize="12"
                                    VerticalAlignment="Center"
                                    Click="HomeExportBackup_Click" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Nothing here leaves your PC." Style="{StaticResource Caption}"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,22,0,0"
                               Foreground="{StaticResource Muted}" />
                </StackPanel>
            </Grid>

            <!-- ============ Storage breakdown ============ -->
            <!-- ============ Devices / pairing ============ -->
            <Grid x:Name="DevicesPanel" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    One screen, read top to bottom: who you are, what is linked, and the
                    rules that apply. It used to be three cards of equal weight stacked on
                    each other, which read as three unrelated panels rather than one page.
                -->
                <Grid Grid.Row="0">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Devices" Style="{StaticResource H1}" />

                        <!-- This PC's own identity, inline under the title rather than in a
                             card of its own at the bottom. It is context for everything
                             below it, not another item in the list. -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="SelfDeviceName" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}"
                                       FontSize="10" Foreground="{StaticResource Faint}"
                                       VerticalAlignment="Center" Margin="10,0,10,0"
                                       ToolTip="Rename this PC" Cursor="Hand"
                                       MouseLeftButtonUp="RenameSelf_Click" />
                            <TextBlock x:Name="SelfFingerprint" Style="{StaticResource Caption}"
                                       FontSize="11" FontFamily="Consolas"
                                       Foreground="{StaticResource Faint}"
                                       VerticalAlignment="Center"
                                       ToolTip="Your phone shows this same code while linking" />
                        </StackPanel>
                    </StackPanel>

                    <Button Style="{StaticResource AccentButton}" Content="+ Link a device"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            MinWidth="150" Height="42" Click="LinkDevice_Click" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,0">
                    <StackPanel>

                        <!-- The list, with its own heading so the section has a shape. -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock x:Name="DevicesHeading" Text="LINKED"
                                       Style="{StaticResource Overline}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock x:Name="DevicesCount" Style="{StaticResource Caption}"
                                       FontSize="11" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel x:Name="DeviceRows" />

                        <!-- Empty state, quieter than a full card: nothing is wrong here,
                             the vault simply works on its own. -->
                        <Border x:Name="NoDevicesCard" Padding="28,30" Visibility="Collapsed"
                                CornerRadius="16" Background="#0A0E16"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE975;" FontFamily="{StaticResource IconFont}"
                                           FontSize="26" Foreground="{StaticResource Faint}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Nothing linked yet" Style="{StaticResource H2}"
                                           HorizontalAlignment="Center" Margin="0,14,0,0" />
                                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                           Margin="0,8,0,0" MaxWidth="460" TextAlignment="Center"
                                           Text="Link your phone to move individual items between it and this PC, over your own network. Lockwell works perfectly well without ever linking anything." />
                            </StackPanel>
                        </Border>

                        <!-- The companion app. It sits here because this is the screen
                             someone is on when they wonder what they would link to. -->
                        <TextBlock Text="LOCKWELL FOR ANDROID" Style="{StaticResource Overline}" Margin="0,28,0,10" />

                        <Border CornerRadius="16" Background="#0A0E16"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="13"
                                        Background="{StaticResource GlassBg}"
                                        BorderBrush="{StaticResource GlassStroke}" BorderThickness="1"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}"
                                               FontSize="18" Foreground="{StaticResource Accent2}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center"
                                            MaxWidth="620">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="A vault on your phone too"
                                                   Style="{StaticResource Body}" VerticalAlignment="Center" />
                                        <Border CornerRadius="7" Padding="7,1" Margin="10,0,0,0"
                                                Background="#28F59E0B" VerticalAlignment="Center">
                                            <TextBlock Text="EARLY" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Warning}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" FontSize="11"
                                               Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="The Android app is a vault in its own right, not a mirror of this one, and it works with no PC involved. It is still early and rougher than the desktop app. Install it by downloading the APK from the releases page; it updates the same way, by installing a newer APK over the top." />
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                        Content="Get the APK" Height="36" MinWidth="120"
                                        Padding="14,0" FontSize="12" VerticalAlignment="Center"
                                        Click="GetAndroidApp_Click" />
                            </Grid>
                        </Border>

                        <!-- The rules, as a settings strip rather than a competing card. -->
                        <TextBlock Text="RULES" Style="{StaticResource Overline}" Margin="0,28,0,10" />

                        <Border CornerRadius="16" Background="#0A0E16"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                Padding="20,4">
                            <StackPanel>
                                <Grid Margin="0,16,0,16">
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="640">
                                        <TextBlock x:Name="ExpiryTitle" Style="{StaticResource Body}"
                                                   Text="Drop links that go quiet for 30 days" />
                                        <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="A device that has not connected in a long time is more likely gone than idle, and a stale link is a standing invitation. Each device can be given its own window when you link it. Re-linking takes seconds." />
                                    </StackPanel>
                                    <CheckBox x:Name="ExpiryToggle" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Click="ExpiryToggle_Click" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource Stroke}" />

                                <Grid Margin="0,16,0,16">
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="640">
                                        <TextBlock Style="{StaticResource Body}"
                                                   Text="Nothing is shared until you send it" />
                                        <TextBlock Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Linked devices talk directly over your local network. There is no server, no account, and nothing is uploaded. A device only ever receives the items you explicitly send it." />
                                    </StackPanel>
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}"
                                               FontSize="16" Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Height="24" Background="Transparent" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="StoragePanel" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="14"
                                Width="36" Height="36" Margin="0,0,12,0"
                                ToolTip="Back to home" Click="StorageBack_Click" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Storage" Style="{StaticResource H1}" />
                            <TextBlock x:Name="StorageSubtitle" Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="StorageTotal" Text="0 KB" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource Text}" HorizontalAlignment="Right" />
                        <TextBlock Text="encrypted on disk" Style="{StaticResource Caption}" FontSize="11"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <StackPanel x:Name="StorageBreadcrumbHost" Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="StorageByLocationButton" Style="{StaticResource GhostButton}"
                                Content="By location" Height="30" MinWidth="96" Padding="12,0" FontSize="11"
                                Click="StorageByLocation_Click" />
                        <Button x:Name="StorageByTypeButton" Style="{StaticResource GhostButton}"
                                Content="By file type" Height="30" MinWidth="96" Padding="12,0" FontSize="11"
                                Margin="6,0,0,0" Click="StorageByType_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,11" Margin="0,14,0,0"
                        Background="#120E1218">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource Accent2}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock x:Name="StorageHint" Style="{StaticResource Caption}" FontSize="11"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel x:Name="StorageRows" />
                </ScrollViewer>
            </Grid>

            <!-- Entry list column -->
            <Border x:Name="ListColumn" Grid.Column="0" Background="#70060810"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
                <Grid Margin="18,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ListTitle" Text="All items" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Text}" />
                            <TextBlock x:Name="ListSubtitle" Text="Browse your vault" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="40" Height="40" CornerRadius="12"
                                Background="{StaticResource AccentBrush}" Cursor="Hand"
                                MouseLeftButtonUp="AddEntry_Click">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="#04231F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Height="42" Padding="40,0,14,0"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchPlaceholder" Text="Search entries..." Foreground="{StaticResource Muted}" FontSize="13"
                                   VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <ListBox Grid.Row="2" x:Name="EntryList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="EntryList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowEntrance}">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Margin" Value="0,4" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="14" Padding="12,11"
                                                    Background="#120E1218" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                                                            Background="#182DD4BF" BorderBrush="#302DD4BF" BorderThickness="1">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Muted}"
                                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- On a linked device. Recorded when a transfer actually
                                                             completes, so it means "the phone has this", not
                                                             "this was queued once". -->
                                                        <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}"
                                                                   FontSize="11" Foreground="{StaticResource Accent}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                                   ToolTip="{Binding SyncedTooltip}"
                                                                   Visibility="{Binding SyncedVisibility}" />
                                                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}"
                                                                   FontSize="12" Foreground="{StaticResource Warning}"
                                                                   VerticalAlignment="Center" Margin="8,0,2,0"
                                                                   Visibility="{Binding FavoriteVisibility}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Stroke}" />
                                                    <Setter TargetName="bd" Property="Background" Value="#1A2030" />
                                                </Trigger>
                                                <!-- The selected row used to add a glow. This border holds
                                                     the entry's own title and subtitle, so the one row you
                                                     were reading was the one row rendered soft. Selection
                                                     is carried by the accent border and fill instead. -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    <Setter TargetName="bd" Property="Background" Value="#242DD4BF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Detail column -->
            <Grid x:Name="DetailColumn" Grid.Column="1" Background="Transparent">
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="84" Height="84" CornerRadius="24" HorizontalAlignment="Center"
                            Background="{StaticResource GlassBg}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="36"
                                   Foreground="{StaticResource Bg3}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Pick an entry" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="Select something from the list to view details." Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <ScrollViewer x:Name="DetailScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,24">
                    <Border x:Name="DetailCard" Style="{StaticResource HeroCard}" Padding="28,24" Background="#140E1218">
                        <StackPanel x:Name="DetailContent">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="58" Height="58" CornerRadius="17" Background="#182DD4BF"
                                            BorderBrush="#302DD4BF" BorderThickness="1">
                                        <TextBlock x:Name="DetailGlyph" Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="DetailTitle" Style="{StaticResource H1}" FontSize="24" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border CornerRadius="7" Padding="8,2" Background="#182DD4BF">
                                                <TextBlock x:Name="DetailKind" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button x:Name="FavButton" Style="{StaticResource IconButton}" Content="&#xE734;" FontSize="16"
                                            ToolTip="Favorite" Click="ToggleFavorite_Click" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70F;" FontSize="15" ToolTip="Edit" Click="EditEntry_Click" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="15" ToolTip="Delete" Click="DeleteEntry_Click" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="FieldsPanel" Margin="0,24,0,0" />

                            <TextBlock x:Name="NotesHeader" Text="NOTES" Style="{StaticResource Overline}" Margin="2,20,0,8" Visibility="Collapsed" />
                            <Border x:Name="NotesCard" Style="{StaticResource Card}" Padding="16" Visibility="Collapsed" Background="#0A0E17">
                                <TextBlock x:Name="NotesText" Style="{StaticResource Body}" />
                            </Border>

                            <Grid Margin="2,24,0,8">
                                <TextBlock Text="ATTACHMENTS" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="+ Add file" HorizontalAlignment="Right" Click="AddAttachment_Click" />
                            </Grid>
                            <WrapPanel x:Name="AttachmentsPanel" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- Media gallery (replaces list + detail) -->
            <Grid x:Name="MediaPanel" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Grid Margin="28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock x:Name="MediaTitle" Text="Media vault" Style="{StaticResource H1}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                <StackPanel x:Name="MediaBreadcrumbHost" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
                                <Button x:Name="MediaFolderEditButton" Style="{StaticResource IconButton}" Content="&#xE70F;"
                                        FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                        ToolTip="Edit folder" Click="MediaFolderEditButton_Click" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="New folder" Height="40" MinWidth="110"
                                    Margin="0,0,8,0" Click="CreateMediaFolder_Click" />
                            <Button Style="{StaticResource GhostButton}" Content="Upload folder" Height="40" MinWidth="120"
                                    Margin="0,0,8,0" Click="UploadMediaFolder_Click" />
                            <Button x:Name="AddMediaButton" Style="{StaticResource AccentButton}" Content="+ Add files"
                                    MinWidth="120" Height="40" Click="AddMedia_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <TextBox x:Name="MediaSearchBox" Style="{StaticResource InputBox}" Height="42" Padding="40,0,14,0"
                                 TextChanged="MediaSearchBox_TextChanged" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                        <TextBlock x:Name="MediaSearchPlaceholder" Text="Search media vault..." Foreground="{StaticResource Muted}" FontSize="13"
                                   VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12" Background="#120E1218">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                <TextBlock x:Name="MediaCount" Text="0 files" Style="{StaticResource Body}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Sort" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button x:Name="MediaSortModeButton" Style="{StaticResource GhostButton}" Height="32" MinWidth="104"
                                        Padding="12,0" FontSize="12" Content="Custom" Click="MediaSortMode_Click"
                                        ToolTip="Change how folders and files are ordered" />
                                <Button x:Name="MediaSortDirectionButton" Style="{StaticResource IconButton}" Content="&#xE74A;"
                                        FontSize="13" Width="32" Height="32" Margin="6,0,0,0"
                                        Click="MediaSortDirection_Click" ToolTip="Reverse order" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="MediaFoldersHeader" Text="FOLDERS" Style="{StaticResource Overline}" Margin="2,0,0,8" Visibility="Collapsed" />
                            <WrapPanel x:Name="MediaFoldersGrid" Margin="0,0,0,8" />

                            <TextBlock x:Name="MediaFilesHeader" Text="FILES" Style="{StaticResource Overline}" Margin="2,8,0,8" Visibility="Collapsed" />
                            <StackPanel x:Name="MediaEmpty" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0">
                                <Border Width="88" Height="88" CornerRadius="24" HorizontalAlignment="Center"
                                        Background="{StaticResource GlassBg}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1"
                                       >
                                    <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                               Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No media yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                                <TextBlock Text="Create a folder, drag and drop from your PC, or add individual files."
                                           Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" MaxWidth="360" TextAlignment="Center" />
                            </StackPanel>
                            <WrapPanel x:Name="MediaGrid" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Border x:Name="MediaDropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                        Background="#402DD4BF" BorderBrush="{StaticResource Accent}" BorderThickness="2"
                        CornerRadius="18" Margin="20,16">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center" />
                        <TextBlock Text="Drop files or folders here" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Subfolders are imported too. Drop onto a folder tile to add inside it."
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   MaxWidth="420" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Overlay -->
        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Background="#CC04060B" Visibility="Collapsed"
              Focusable="True" PreviewKeyDown="Overlay_PreviewKeyDown">
            <Border x:Name="OverlayCard" Style="{StaticResource HeroCard}" Background="#F20C111B"
                    MinWidth="460" MaxWidth="560" MaxHeight="640"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="OverlayTitle" Style="{StaticResource H2}"
                                   VerticalAlignment="Center" Margin="0,0,44,0"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="OverlayCloseButton" Style="{StaticResource IconButton}"
                                Content="&#xE8BB;" FontSize="14" Width="34" Height="34"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                ToolTip="Cancel (Esc)" Click="OverlayCancel_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <StackPanel x:Name="OverlayBody" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2">
                        <Border x:Name="OverlayErrorBanner" Visibility="Collapsed" Margin="0,16,0,0"
                                CornerRadius="10" Padding="12,9" Background="#22F87171"
                                BorderBrush="{StaticResource Danger}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{StaticResource Danger}" VerticalAlignment="Center"
                                           Margin="0,0,9,0" />
                                <TextBlock x:Name="OverlayErrorText" Foreground="{StaticResource Text}"
                                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,18,0,0">
                            <Button x:Name="OverlayCancel" Style="{StaticResource GhostButton}" Content="Cancel"
                                    HorizontalAlignment="Left" MinWidth="110" Click="OverlayCancel_Click" />
                            <Button x:Name="OverlaySave" Style="{StaticResource AccentButton}" Content="Save"
                                    HorizontalAlignment="Right" MinWidth="130" Click="OverlaySave_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Long-running operation progress -->
        <Grid x:Name="ProgressOverlay" Grid.ColumnSpan="2" Background="#D904060B" Visibility="Collapsed"
              IsHitTestVisible="True">
            <Border Style="{StaticResource HeroCard}" Width="460" MaxWidth="460" Padding="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Background="#F20C111B">
                <StackPanel>
                    <TextBlock x:Name="ProgressTitle" Style="{StaticResource H2}" Text="Working..." />
                    <TextBlock x:Name="ProgressDetail" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="ProgressBar" Height="8" Margin="0,18,0,0"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="{StaticResource Accent}" Background="#22FFFFFF" BorderThickness="0" />
                    <TextBlock x:Name="ProgressCount" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
                    <Button x:Name="ProgressCancelButton" Style="{StaticResource GhostButton}" Content="Stop"
                            Height="34" MinWidth="100" Margin="0,16,0,0" Visibility="Collapsed"
                            HorizontalAlignment="Center" Click="ProgressCancel_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Media viewer (photos, audio, video) -->
        <Grid x:Name="ImageViewer" Grid.ColumnSpan="2" Background="#F204060B" Visibility="Collapsed"
              Focusable="True" PreviewKeyDown="ImageViewer_PreviewKeyDown"
              PreviewMouseDown="ImageViewer_PreviewMouseDown">
            <Image x:Name="ViewerImage" Stretch="Uniform" Margin="96,72,96,120" />

            <MediaElement x:Name="ViewerMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                          Visibility="Collapsed" Margin="72,64,72,120"
                          MediaOpened="ViewerMedia_MediaOpened" MediaFailed="ViewerMedia_MediaFailed"
                          MediaEnded="ViewerMedia_MediaEnded" />

            <Border x:Name="AudioPlayerCard" Style="{StaticResource HeroCard}" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40,36" MaxWidth="440"
                    Background="#140E1218">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="88" Height="88" CornerRadius="24" HorizontalAlignment="Center"
                            Background="{StaticResource GlassBg}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1"
                           >
                        <TextBlock Text="&#xE189;" FontFamily="{StaticResource IconFont}" FontSize="36"
                                   Foreground="{StaticResource Violet}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="AudioTitleText" Style="{StaticResource H2}" HorizontalAlignment="Center"
                               Margin="0,20,0,0" TextTrimming="CharacterEllipsis" MaxWidth="340" TextAlignment="Center" />
                    <TextBlock Text="Playing in Lockwell" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="MediaLoadingPanel" Visibility="Collapsed" IsHitTestVisible="False"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="180" Height="4" BorderThickness="0"
                             Foreground="{StaticResource Accent}" Background="#22FFFFFF" />
                <TextBlock Text="Decrypting..." Style="{StaticResource Caption}" Margin="0,14,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="MediaLoadingText" Style="{StaticResource Caption}" Margin="0,4,0,0"
                           HorizontalAlignment="Center" Foreground="{StaticResource Muted}"
                           MaxWidth="360" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button x:Name="ViewerPrevButton" Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="20"
                    Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0"
                    ToolTip="Previous" Click="ViewerPrev_Click" Visibility="Collapsed" />
            <Button x:Name="ViewerNextButton" Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="20"
                    Width="48" Height="48" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0"
                    ToolTip="Next" Click="ViewerNext_Click" Visibility="Collapsed" />

            <Grid VerticalAlignment="Top" Margin="22,22,22,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="ViewerDownloadButton" Style="{StaticResource GhostButton}" Height="40" MinWidth="130"
                            Margin="0,0,8,0" Click="ViewerDownload_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Download" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ViewerCompressButton" Style="{StaticResource GhostButton}" Height="40" MinWidth="130"
                            Margin="0,0,8,0" Click="ViewerCompress_Click" ToolTip="Make this file smaller">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73F;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Compress" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Rename and Send, on the item you are actually looking at. Renaming
                         used to be reachable only from the folder listing, which meant
                         opening a picture, recognising it, closing it, finding it again in
                         the list and renaming it there. Sending had the same shape. -->
                    <Button x:Name="ViewerRenameButton" Style="{StaticResource GhostButton}" Height="40" MinWidth="120"
                            Margin="0,0,8,0" Click="ViewerRename_Click" ToolTip="Give this file a name">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Rename" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ViewerSendButton" Style="{StaticResource GhostButton}" Height="40" MinWidth="140"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="ViewerSend_Click"
                            ToolTip="Send this file to a linked device">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Send to device" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ViewerDownloadFolderButton" Style="{StaticResource GhostButton}" Height="40" MinWidth="150"
                            Visibility="Collapsed" Click="ViewerDownloadFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Download folder" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Speed control, shown only while an animated image is playing.
                         Many GIFs and WebPs record frame delays that no renderer honours,
                         so being able to set a real rate is the difference between a
                         slideshow and the animation as it was meant to look. -->
                    <Button x:Name="ViewerSpeedButton" Style="{StaticResource GhostButton}" Height="40" MinWidth="110"
                            Visibility="Collapsed" Click="ViewerSpeed_Click"
                            ToolTip="Change how fast this animation plays">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="ViewerSpeedText" Text="12 fps" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Popup x:Name="ViewerSpeedPopup" PlacementTarget="{Binding ElementName=ViewerSpeedButton}"
                           Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource GlassStroke}"
                                BorderThickness="1" CornerRadius="14" Padding="18,16" Width="300">
                            <StackPanel>
                                <TextBlock Text="ANIMATION SPEED" Style="{StaticResource Overline}" />

                                <Grid Margin="0,14,0,0">
                                    <TextBox x:Name="ViewerSpeedBox" Style="{StaticResource InputBox}"
                                             Width="72" HorizontalAlignment="Left" TextAlignment="Center"
                                             ToolTip="Type a rate and press Enter"
                                             KeyDown="ViewerSpeedBox_KeyDown" LostFocus="ViewerSpeedBox_Commit" />
                                    <TextBlock Text="frames per second" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" HorizontalAlignment="Left"
                                               Margin="84,0,0,0" />
                                </Grid>

                                <Slider x:Name="ViewerSpeedSlider" Minimum="0" Maximum="60"
                                        Style="{StaticResource MediaSeekSlider}" Margin="0,14,0,0"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        ValueChanged="ViewerSpeedSlider_ValueChanged" />

                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="0 = paused" Style="{StaticResource Caption}" FontSize="11"
                                               HorizontalAlignment="Left" />
                                    <TextBlock Text="60" Style="{StaticResource Caption}" FontSize="11"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <Button x:Name="ViewerSpeedResetButton" Style="{StaticResource GhostButton}"
                                        Height="34" Margin="0,14,0,0" Click="ViewerSpeedReset_Click"
                                        Content="Use the file's own timing" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="16" HorizontalAlignment="Right"
                        ToolTip="Close" Click="CloseViewer_Click" />
            </Grid>

            <Border x:Name="MediaTransportBar" Visibility="Collapsed" VerticalAlignment="Bottom"
                    Background="#E606080D" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1"
                    CornerRadius="16" Padding="18,14" Margin="48,0,48,36">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MediaPlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="18"
                                Width="44" Height="44" Click="MediaPlayPause_Click" ToolTip="Play / pause (Space)" />
                        <Slider x:Name="MediaSeekSlider" Grid.Column="1" Style="{StaticResource MediaSeekSlider}"
                                VerticalAlignment="Center" Margin="14,0,14,0" Minimum="0" Maximum="1" Value="0"
                                PreviewMouseDown="MediaSeekSlider_PreviewMouseDown"
                                PreviewMouseUp="MediaSeekSlider_PreviewMouseUp"
                                PreviewMouseLeftButtonUp="MediaSeekSlider_PreviewMouseUp"
                                LostMouseCapture="MediaSeekSlider_LostMouseCapture"
                                ValueChanged="MediaSeekSlider_ValueChanged" />
                        <TextBlock x:Name="MediaTimeText" Grid.Column="2" Style="{StaticResource Caption}" FontSize="11"
                                   VerticalAlignment="Center" Text="0:00 / 0:00" MinWidth="88" TextAlignment="Right" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="52,10,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Slider x:Name="MediaVolumeSlider" Style="{StaticResource MediaSeekSlider}"
                                Width="120" Margin="10,0,0,0" Minimum="0" Maximum="1"
                                Value="1" VerticalAlignment="Center" ValueChanged="MediaVolumeSlider_ValueChanged" />
                        <TextBlock x:Name="MediaVolumeText" Style="{StaticResource Caption}" FontSize="11"
                                   VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="34" Text="100%" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel x:Name="PhotoCaptionPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26">
                <TextBlock x:Name="ViewerCaption" Foreground="{StaticResource Text}" FontSize="13"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                <TextBlock x:Name="ViewerPosition" Foreground="{StaticResource Muted}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
