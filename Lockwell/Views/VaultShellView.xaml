<UserControl x:Class="Lockwell.Views.VaultShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SidebarRow" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Padding="9,0" Height="31" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="catGlyph" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" Foreground="{StaticResource Faint}" Width="24"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="catName" Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="count" Grid.Column="2" Text="{Binding CountLabel}" FontSize="11"
                                           Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <TextBlock x:Name="fold" Grid.Column="2" Text="&#xE70D;"
                                           FontFamily="{StaticResource IconFont}" FontSize="8"
                                           Foreground="{StaticResource Faint}" Visibility="Collapsed"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg2}" />
                                <Setter TargetName="catName" Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                                <Setter TargetName="catName" Property="Foreground" Value="{StaticResource Text}" />
                                <Setter TargetName="catGlyph" Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <!--
                                Group labels live in the same list so selection stays in one
                                place, but must not look or behave like a section.
                            -->
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter TargetName="catGlyph" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="count" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="bd" Property="Margin" Value="0,12,0,0" />
                                <Setter TargetName="bd" Property="Height" Value="24" />
                                <Setter TargetName="bd" Property="Background" Value="Transparent" />
                                <Setter TargetName="catName" Property="FontSize" Value="11" />
                                <Setter TargetName="catName" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="catName" Property="Foreground" Value="{StaticResource Faint}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFoldable}" Value="True">
                                <Setter TargetName="fold" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <Setter TargetName="fold" Property="Text" Value="&#xE70E;" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListRow" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="7" Padding="11,8" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           Foreground="{StaticResource Faint}" Width="28" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                               Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Faint}"
                                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}"
                                               FontSize="11" Foreground="{StaticResource Faint}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               ToolTip="{Binding SyncedTooltip}"
                                               Visibility="{Binding SyncedVisibility}" />
                                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}"
                                               FontSize="11" Foreground="{StaticResource Warning}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Visibility="{Binding FavoriteVisibility}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultRow" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Padding="10,7" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource Faint}" Width="28" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                           Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12"
                                           Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                           Margin="16,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg2}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchPill" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{StaticResource Bg0}"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="9,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource Faint}" Width="24" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Search" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Ctrl K" FontSize="11"
                                           Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A424E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ShellRoot" Background="{StaticResource Bg0}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource Bg1}"
                BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <Grid Margin="10,8,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Style="{StaticResource SearchPill}" Margin="0,0,0,10"
                        ToolTip="Search the whole vault" Click="OpenSearch_Click" />

                <ListBox Grid.Row="1" x:Name="CategoryList" Style="{StaticResource FlatList}"
                         ItemContainerStyle="{StaticResource SidebarRow}"
                         SelectionChanged="CategoryList_SelectionChanged" />

                <Button Grid.Row="2" Style="{StaticResource QuietButton}" Height="30" Margin="0,6,0,6"
                        FontSize="12" HorizontalContentAlignment="Left" Padding="9,0"
                        Click="AddCategory_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   Width="24" VerticalAlignment="Center" />
                        <TextBlock Text="New section" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid Grid.Row="3">
                    <Border Height="1" Background="{StaticResource Stroke}" VerticalAlignment="Top" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VaultNameText" FontSize="12" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="9,0,4,0" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- The update marker waits here. A found update is worth knowing about
                                 but never worth interrupting someone who just opened their vault. -->
                            <Grid>
                                <Button x:Name="DevicesButton" Style="{StaticResource IconButton}" Content="&#xE975;"
                                        ToolTip="Devices" Click="Devices_Click" />
                                <Border x:Name="DeviceCountBadge" Visibility="Collapsed" IsHitTestVisible="False"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                                        CornerRadius="7" MinWidth="13" Height="13" Padding="3,0"
                                        Background="{StaticResource Bg3}">
                                    <TextBlock x:Name="DeviceCountText" FontSize="9" Text="0"
                                               Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <Grid>
                                <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                                        ToolTip="Settings (Ctrl ,)" Click="Settings_Click" />
                                <Border x:Name="UpdateBadge" Visibility="Collapsed" IsHitTestVisible="False"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                        Width="7" Height="7" CornerRadius="3.5" Background="{StaticResource Accent}">
                                    <TextBlock x:Name="UpdateBadgeText" Visibility="Collapsed" />
                                </Border>
                            </Grid>
                            <Button Style="{StaticResource IconButton}" Content="&#xE72E;"
                                    ToolTip="Lock (Ctrl L)" Click="Lock_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ Main workspace ============ -->
        <Grid x:Name="MainWorkspace" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="318" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Only appears when a backup is overdue, and can be dismissed for the session. -->
            <Border x:Name="BackupNudge" Grid.ColumnSpan="2" Visibility="Collapsed"
                    Background="{StaticResource WarningSoft}" Padding="16,6,8,6"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BackupNudgeText" FontSize="12" Foreground="{StaticResource Text}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="26" FontSize="12"
                            Padding="10,0" Content="Back up now" Click="BackupNudge_Click" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                            Width="26" Height="26" Margin="4,0,0,0" ToolTip="Not now" Click="BackupNudgeDismiss_Click" />
                </Grid>
            </Border>

            <!-- ============ Settings ============ -->
            <Grid x:Name="SettingsPanel" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="12,18,12,12">
                        <TextBlock Text="Settings" Style="{StaticResource H2}" Margin="10,0,0,14" />
                        <StackPanel x:Name="SettingsNav" />
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Column="1" x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="680" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="SettingsBody" Margin="32,22,32,40" />
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ============ Devices / pairing ============ -->
            <Grid x:Name="DevicesPanel" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="28,20,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Devices" Style="{StaticResource H1}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock x:Name="SelfDeviceName" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}"
                                       FontSize="10" Foreground="{StaticResource Faint}"
                                       VerticalAlignment="Center" Margin="8,0,10,0"
                                       ToolTip="Rename this PC" Cursor="Hand"
                                       MouseLeftButtonUp="RenameSelf_Click" />
                            <TextBlock x:Name="SelfFingerprint" Style="{StaticResource Caption}"
                                       FontSize="11" FontFamily="Consolas"
                                       Foreground="{StaticResource Faint}"
                                       VerticalAlignment="Center"
                                       ToolTip="Your phone shows this same code while linking" />
                        </StackPanel>
                    </StackPanel>

                    <Button Style="{StaticResource AccentButton}" Content="Link a device"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="LinkDevice_Click" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,-14,0" Padding="0,0,14,0">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="820" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="DevicesHeading" Text="LINKED" Style="{StaticResource Overline}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock x:Name="DevicesCount" Style="{StaticResource Caption}"
                                       FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel x:Name="DeviceRows" />

                        <StackPanel x:Name="NoDevicesCard" Visibility="Collapsed" Margin="0,10,0,6" MaxWidth="460"
                                    HorizontalAlignment="Left">
                            <TextBlock Text="Nothing linked yet" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Text="Link your phone to move individual items between it and this PC, over your own network. Lockwell works perfectly well without it." />
                        </StackPanel>

                        <TextBlock Text="RULES" Style="{StaticResource Overline}" Margin="0,26,0,4" />
                        <Border Height="1" Background="{StaticResource Stroke}" />
                        <Grid Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ExpiryTitle" Style="{StaticResource Body}"
                                           Text="Drop links that go quiet for 30 days" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                                           Text="A device that has not connected in a long time is more likely gone than idle. Re-linking takes seconds." />
                            </StackPanel>
                            <CheckBox x:Name="ExpiryToggle" Grid.Column="1" Margin="20,0,0,0"
                                      VerticalAlignment="Center" Click="ExpiryToggle_Click" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource Stroke}" />
                        <StackPanel Margin="0,12,0,12">
                            <TextBlock Style="{StaticResource Body}" Text="Nothing is shared until you send it" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                                       Text="Linked devices talk directly over your local network. There is no server and no account. A device only receives the items you send it." />
                        </StackPanel>

                        <TextBlock Text="LOCKWELL FOR ANDROID" Style="{StaticResource Overline}" Margin="0,18,0,4" />
                        <Border Height="1" Background="{StaticResource Stroke}" />
                        <Grid Margin="0,12,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="A vault on your phone too" Style="{StaticResource Body}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                                           Text="A vault in its own right, not a mirror of this one, and it works with no PC involved. Still early, and rougher than the desktop app." />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="20,0,0,0"
                                    Content="Get the APK" VerticalAlignment="Center" Click="GetAndroidApp_Click" />
                        </Grid>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ============ Storage breakdown ============ -->
            <Grid x:Name="StoragePanel" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="28,20,28,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource IconButton}" Content="&#xE72B;"
                                Margin="-6,0,8,0" ToolTip="Back" Click="StorageBack_Click" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Storage" Style="{StaticResource H1}" />
                            <TextBlock x:Name="StorageSubtitle" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="StorageTotal" Text="0 KB" Style="{StaticResource H1}" HorizontalAlignment="Right" />
                        <TextBlock Text="encrypted on disk" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <StackPanel x:Name="StorageBreadcrumbHost" Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="StorageByLocationButton" Style="{StaticResource GhostButton}"
                                Content="By location" Height="28" FontSize="12" Padding="10,0"
                                Click="StorageByLocation_Click" />
                        <Button x:Name="StorageByTypeButton" Style="{StaticResource GhostButton}"
                                Content="By file type" Height="28" FontSize="12" Padding="10,0"
                                Margin="6,0,0,0" Click="StorageByType_Click" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="StorageHint" Grid.Row="2" Style="{StaticResource Caption}" Margin="0,12,0,0" />

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,10,-14,0" Padding="0,0,14,0">
                    <StackPanel x:Name="StorageRows" Margin="0,0,0,24" />
                </ScrollViewer>
            </Grid>

            <!-- ============ Item list ============ -->
            <Border x:Name="ListColumn" Grid.Row="1" Grid.Column="0"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,10,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ListTitle" Text="All items" Style="{StaticResource H2}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,40,0" />
                            <TextBlock x:Name="ListSubtitle" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" Foreground="{StaticResource Accent}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="New item (Ctrl N)" Click="AddEntry_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="12,0,12,8">
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Height="32"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Text="Filter this list" Foreground="{StaticResource Faint}"
                                   FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                    </Grid>

                    <ListBox Grid.Row="2" x:Name="EntryList" Style="{StaticResource FlatList}" Padding="6,0,6,8"
                             ItemContainerStyle="{StaticResource ListRow}"
                             SelectionChanged="EntryList_SelectionChanged" />
                </Grid>
            </Border>

            <!-- ============ Item detail ============ -->
            <Grid x:Name="DetailColumn" Grid.Row="1" Grid.Column="1">
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyStateTitle" Text="Select an item" Style="{StaticResource Body}"
                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyStateHint" Text="Or press Ctrl K to find anything." Style="{StaticResource Caption}"
                               Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <Button x:Name="EmptyStateAction" Style="{StaticResource AccentButton}" Content="New item"
                            HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed"
                            Click="AddEntry_Click" />
                </StackPanel>

                <ScrollViewer x:Name="DetailScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="740" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="DetailCard" Margin="28,18,28,32">
                        <StackPanel x:Name="DetailContent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailTitle" Style="{StaticResource H1}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock x:Name="DetailGlyph" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                   Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock x:Name="DetailKind" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,-6,0">
                                    <Button x:Name="FavButton" Style="{StaticResource IconButton}" Content="&#xE734;"
                                            ToolTip="Favorite" Click="ToggleFavorite_Click" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Edit" Click="EditEntry_Click" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete" Click="DeleteEntry_Click" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="FieldsPanel" Margin="0,18,0,0" />

                            <TextBlock x:Name="NotesHeader" Text="NOTES" Style="{StaticResource Overline}"
                                       Margin="0,20,0,6" Visibility="Collapsed" />
                            <Border x:Name="NotesCard" Visibility="Collapsed">
                                <TextBox x:Name="NotesText" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                                         TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Text}"
                                         CaretBrush="Transparent" SelectionBrush="{StaticResource Accent}"
                                         FocusVisualStyle="{x:Null}" Padding="0" />
                            </Border>

                            <Grid Margin="0,22,0,6">
                                <TextBlock Text="FILES" Style="{StaticResource Overline}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="Add file" FontSize="12"
                                        HorizontalAlignment="Right" Click="AddAttachment_Click" />
                            </Grid>
                            <StackPanel x:Name="AttachmentsPanel" />
                            <TextBlock x:Name="AttachmentsEmpty" Text="No files attached." Style="{StaticResource Caption}"
                                       Foreground="{StaticResource Faint}" />
                        </StackPanel>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ============ Files ============ -->
            <Grid x:Name="MediaPanel" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{StaticResource Bg0}">
                <Grid Margin="24,16,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="MediaTitle" Text="Files" Style="{StaticResource H1}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                <StackPanel x:Name="MediaFolderActions" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button x:Name="MediaFolderEditButton" Style="{StaticResource IconButton}" Content="&#xE70F;"
                                            FontSize="13" Width="28" Height="28" Visibility="Collapsed"
                                            ToolTip="Edit folder" Click="MediaFolderEditButton_Click" />
                                    <Button x:Name="MediaFolderExportButton" Style="{StaticResource IconButton}" Content="&#xE896;"
                                            FontSize="13" Width="28" Height="28" Visibility="Collapsed"
                                            ToolTip="Export this folder out of the vault" Click="MediaFolderExportButton_Click" />
                                    <Button x:Name="MediaFolderDeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                            FontSize="13" Width="28" Height="28" Visibility="Collapsed"
                                            ToolTip="Delete this folder and everything in it" Click="MediaFolderDeleteButton_Click" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <StackPanel x:Name="MediaBreadcrumbHost" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="Collapsed" Margin="0,0,10,0" />
                                <TextBlock x:Name="MediaCount" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="170" Margin="0,0,8,0">
                                <TextBox x:Name="MediaSearchBox" Style="{StaticResource InputBox}" Height="32"
                                         TextChanged="MediaSearchBox_TextChanged" />
                                <TextBlock x:Name="MediaSearchPlaceholder" Text="Filter" Foreground="{StaticResource Faint}"
                                           FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                            </Grid>
                            <Button x:Name="MediaSortModeButton" Style="{StaticResource QuietButton}" Height="32"
                                    Padding="10,0" FontSize="12" Content="Custom" Click="MediaSortMode_Click"
                                    ToolTip="Change how folders and files are ordered" />
                            <Button x:Name="MediaSortDirectionButton" Style="{StaticResource IconButton}" Content="&#xE74A;"
                                    FontSize="12" Click="MediaSortDirection_Click" ToolTip="Reverse order" />
                            <Button x:Name="MediaViewToggle" Style="{StaticResource IconButton}" Content="&#xE8FD;"
                                    FontSize="13" Margin="0,0,8,0" Click="MediaViewToggle_Click" ToolTip="Show as a list" />
                            <Button x:Name="AddMediaButton" Style="{StaticResource AccentButton}" Click="AddMenu_Click" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Add" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                               Margin="7,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="AddMenu">
                                        <MenuItem Header="Add files" Click="AddMedia_Click" />
                                        <MenuItem Header="Add a folder from this PC" Click="UploadMediaFolder_Click" />
                                        <Separator />
                                        <MenuItem Header="New empty folder" Click="CreateMediaFolder_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Appears only while something is selected, so the page is quiet the rest of the time. -->
                    <Border x:Name="MediaSelectionBar" Grid.Row="1" Visibility="Collapsed" Margin="0,12,14,0"
                            Background="{StaticResource Bg2}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                            CornerRadius="8" Padding="12,5,5,5">
                        <Grid>
                            <TextBlock x:Name="MediaSelectionText" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource QuietButton}" Height="28" Padding="10,0" FontSize="12"
                                        Foreground="{StaticResource Text}" Content="Move to" Click="SelectionMove_Click" />
                                <Button Style="{StaticResource QuietButton}" Height="28" Padding="10,0" FontSize="12"
                                        Foreground="{StaticResource Text}" Content="Export" Click="SelectionExport_Click" />
                                <Button Style="{StaticResource QuietButton}" Height="28" Padding="10,0" FontSize="12"
                                        Foreground="{StaticResource Danger}" Content="Delete" Click="SelectionDelete_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                        Width="28" Height="28" Margin="4,0,0,0" ToolTip="Clear selection (Esc)"
                                        Click="SelectionClear_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="MediaScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"
                                  Padding="0,0,14,0">
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock x:Name="MediaFoldersHeader" Text="FOLDERS" Style="{StaticResource Overline}" Margin="0,0,0,8" Visibility="Collapsed" />
                            <WrapPanel x:Name="MediaFoldersGrid" Margin="0,0,0,12" />

                            <TextBlock x:Name="MediaFilesHeader" Text="FILES" Style="{StaticResource Overline}" Margin="0,2,0,8" Visibility="Collapsed" />
                            <StackPanel x:Name="MediaEmpty" HorizontalAlignment="Center" Margin="0,90,0,0">
                                <TextBlock Text="Nothing here yet" Style="{StaticResource Body}" Foreground="{StaticResource Muted}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Drag files or folders in, or use Add. Any kind of file works."
                                           Style="{StaticResource Caption}" Foreground="{StaticResource Faint}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                            <WrapPanel x:Name="MediaGrid" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border x:Name="MediaDropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                        Background="#CC0C0E12" BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                        CornerRadius="10" Margin="12">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Drop to add to the vault" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                        <TextBlock Text="Subfolders come too. Drop onto a folder to add inside it."
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Dialog -->
        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Background="{StaticResource Scrim}" Visibility="Collapsed"
              Focusable="True" PreviewKeyDown="Overlay_PreviewKeyDown">
            <Border x:Name="OverlayCard" Style="{StaticResource HeroCard}" Background="{StaticResource Bg1}"
                    MinWidth="440" MaxWidth="560" MaxHeight="620"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22,18,22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="OverlayTitle" Style="{StaticResource H2}"
                                   VerticalAlignment="Center" Margin="0,0,40,0"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="OverlayCloseButton" Style="{StaticResource IconButton}"
                                Content="&#xE711;" FontSize="11" Width="28" Height="28" Margin="0,-3,-6,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                ToolTip="Cancel (Esc)" Click="OverlayCancel_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel x:Name="OverlayBody" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2">
                        <Border x:Name="OverlayErrorBanner" Visibility="Collapsed" Margin="0,14,0,0"
                                CornerRadius="7" Padding="11,8" Background="{StaticResource DangerSoft}">
                            <TextBlock x:Name="OverlayErrorText" Foreground="{StaticResource Text}"
                                       FontSize="12" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button x:Name="OverlayCancel" Style="{StaticResource GhostButton}" Content="Cancel"
                                    MinWidth="84" Click="OverlayCancel_Click" />
                            <Button x:Name="OverlaySave" Style="{StaticResource AccentButton}" Content="Save"
                                    MinWidth="84" Margin="8,0,0,0" Click="OverlaySave_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Search everything -->
        <Grid x:Name="SearchOverlay" Grid.ColumnSpan="2" Background="{StaticResource Scrim}" Visibility="Collapsed"
              MouseDown="SearchOverlay_MouseDown">
            <Border x:Name="SearchCard" Style="{StaticResource HeroCard}" Background="{StaticResource Bg1}" Width="580"
                    VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,70,0,40"
                    MouseDown="SearchCard_MouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,0">
                        <TextBox x:Name="SearchInput" Background="Transparent" BorderThickness="0" Height="46"
                                 FontSize="15" Foreground="{StaticResource Text}" CaretBrush="{StaticResource Accent}"
                                 SelectionBrush="{StaticResource Accent}" VerticalContentAlignment="Center"
                                 FocusVisualStyle="{x:Null}" TextChanged="SearchInput_TextChanged"
                                 PreviewKeyDown="SearchInput_PreviewKeyDown" />
                        <TextBlock x:Name="SearchInputHint" Text="Search items, files, folders, or type a command"
                                   FontSize="15" Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                   Margin="2,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
                        <Grid>
                            <ListBox x:Name="SearchResults" Style="{StaticResource FlatList}" MaxHeight="400" Padding="6"
                                     ItemContainerStyle="{StaticResource ResultRow}"
                                     PreviewMouseLeftButtonUp="SearchResults_Click" />
                            <TextBlock x:Name="SearchNoResults" Text="Nothing found. Secret fields and notes are not searched."
                                       Style="{StaticResource Caption}" Foreground="{StaticResource Faint}"
                                       Margin="16,16,16,16" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="16,7">
                        <TextBlock x:Name="SearchHint" FontSize="11" Foreground="{StaticResource Faint}"
                                   Text="Enter to open    Ctrl Enter to copy the password    Esc to close" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Long-running operation progress -->
        <Grid x:Name="ProgressOverlay" Grid.ColumnSpan="2" Background="{StaticResource Scrim}" Visibility="Collapsed"
              IsHitTestVisible="True">
            <Border Style="{StaticResource HeroCard}" Width="420" Padding="22,18"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ProgressTitle" Style="{StaticResource H2}" Text="Working..." />
                    <TextBlock x:Name="ProgressDetail" Style="{StaticResource Caption}" Margin="0,6,0,0"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="ProgressBar" Margin="0,14,0,0" Minimum="0" Maximum="100" Value="0" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock x:Name="ProgressCount" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Foreground="{StaticResource Faint}" />
                        <Button x:Name="ProgressCancelButton" Style="{StaticResource GhostButton}" Content="Stop"
                                Height="28" FontSize="12" Visibility="Collapsed"
                                HorizontalAlignment="Right" Click="ProgressCancel_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Media viewer (photos, audio, video) -->
        <Grid x:Name="ImageViewer" Grid.ColumnSpan="2" Background="#080A0D" Visibility="Collapsed"
              Focusable="True" PreviewKeyDown="ImageViewer_PreviewKeyDown"
              PreviewMouseDown="ImageViewer_PreviewMouseDown" PreviewMouseMove="ImageViewer_PreviewMouseMove">
            <Image x:Name="ViewerImage" Stretch="Uniform" Margin="24,24,24,24" />

            <MediaElement x:Name="ViewerMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                          Visibility="Collapsed" Margin="24,24,24,24"
                          MediaOpened="ViewerMedia_MediaOpened" MediaFailed="ViewerMedia_MediaFailed"
                          MediaEnded="ViewerMedia_MediaEnded" />

            <StackPanel x:Name="AudioPlayerCard" Visibility="Collapsed" VerticalAlignment="Center"
                        HorizontalAlignment="Center" MaxWidth="420">
                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="34"
                           Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
                <TextBlock x:Name="AudioTitleText" Style="{StaticResource H2}" HorizontalAlignment="Center"
                           Margin="0,14,0,0" TextTrimming="CharacterEllipsis" MaxWidth="400" TextAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="MediaLoadingPanel" Visibility="Collapsed" IsHitTestVisible="False"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="160" />
                <TextBlock Text="Decrypting..." Style="{StaticResource Caption}" Margin="0,12,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="MediaLoadingText" Style="{StaticResource Caption}" Margin="0,3,0,0"
                           HorizontalAlignment="Center" Foreground="{StaticResource Faint}"
                           MaxWidth="360" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button x:Name="ViewerPrevButton" Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="16"
                    Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                    ToolTip="Previous" Click="ViewerPrev_Click" Visibility="Collapsed" />
            <Button x:Name="ViewerNextButton" Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="16"
                    Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip="Next" Click="ViewerNext_Click" Visibility="Collapsed" />

            <!-- Fades out when the mouse rests, so the picture gets the whole window. -->
            <Border x:Name="ViewerTopBar" VerticalAlignment="Top" Background="#D90C0E12" Padding="10,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="ViewerDownloadButton" Style="{StaticResource IconButton}" Content="&#xE896;"
                                Click="ViewerDownload_Click" ToolTip="Save a decrypted copy" />
                        <Button x:Name="ViewerRenameButton" Style="{StaticResource IconButton}" Content="&#xE8AC;"
                                Click="ViewerRename_Click" ToolTip="Rename" />
                        <Button x:Name="ViewerCompressButton" Style="{StaticResource IconButton}" Content="&#xE73F;"
                                Click="ViewerCompress_Click" ToolTip="Make this file smaller" />
                        <Button x:Name="ViewerSendButton" Style="{StaticResource IconButton}" Content="&#xE8EA;"
                                Visibility="Collapsed" Click="ViewerSend_Click" ToolTip="Send to a linked device" />
                        <Button x:Name="ViewerDownloadFolderButton" Style="{StaticResource IconButton}" Content="&#xE8B7;"
                                Visibility="Collapsed" Click="ViewerDownloadFolder_Click" ToolTip="Export this whole folder" />
                        <Button x:Name="ViewerSpeedButton" Style="{StaticResource QuietButton}" Height="32" Padding="10,0"
                                Margin="4,0,0,0" FontSize="12" Visibility="Collapsed" Click="ViewerSpeed_Click"
                                ToolTip="Change how fast this animation plays">
                            <TextBlock x:Name="ViewerSpeedText" Text="12 fps" VerticalAlignment="Center" />
                        </Button>

                        <Popup x:Name="ViewerSpeedPopup" PlacementTarget="{Binding ElementName=ViewerSpeedButton}"
                               Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource Bg2}" BorderBrush="#3A424E"
                                    BorderThickness="1" CornerRadius="9" Padding="14,12" Width="280">
                                <StackPanel>
                                    <Grid>
                                        <TextBox x:Name="ViewerSpeedBox" Style="{StaticResource InputBox}"
                                                 Width="64" Height="30" HorizontalAlignment="Left" TextAlignment="Center"
                                                 ToolTip="Type a rate and press Enter"
                                                 KeyDown="ViewerSpeedBox_KeyDown" LostFocus="ViewerSpeedBox_Commit" />
                                        <TextBlock Text="frames per second" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   Margin="74,0,0,0" />
                                    </Grid>
                                    <Slider x:Name="ViewerSpeedSlider" Minimum="0" Maximum="60"
                                            Style="{StaticResource MediaSeekSlider}" Margin="0,10,0,0"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            ValueChanged="ViewerSpeedSlider_ValueChanged" />
                                    <Grid Margin="0,2,0,0">
                                        <TextBlock Text="0 = paused" Style="{StaticResource Caption}" FontSize="11"
                                                   HorizontalAlignment="Left" />
                                        <TextBlock Text="60" Style="{StaticResource Caption}" FontSize="11"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Button x:Name="ViewerSpeedResetButton" Style="{StaticResource GhostButton}"
                                            Height="28" FontSize="12" Margin="0,10,0,0" Click="ViewerSpeedReset_Click"
                                            Content="Use the file's own timing" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <StackPanel x:Name="PhotoCaptionPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock x:Name="ViewerCaption" Foreground="{StaticResource Text}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="440" />
                        <TextBlock x:Name="ViewerPosition" Foreground="{StaticResource Faint}" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" HorizontalAlignment="Right"
                            ToolTip="Close (Esc)" Click="CloseViewer_Click" />
                </Grid>
            </Border>

            <Border x:Name="MediaTransportBar" Visibility="Collapsed" VerticalAlignment="Bottom"
                    Background="#D90C0E12" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MediaPlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="14"
                            Click="MediaPlayPause_Click" ToolTip="Play / pause (Space)" />
                    <Slider x:Name="MediaSeekSlider" Grid.Column="1" Style="{StaticResource MediaSeekSlider}"
                            VerticalAlignment="Center" Margin="10,0,12,0" Minimum="0" Maximum="1" Value="0"
                            PreviewMouseDown="MediaSeekSlider_PreviewMouseDown"
                            PreviewMouseUp="MediaSeekSlider_PreviewMouseUp"
                            PreviewMouseLeftButtonUp="MediaSeekSlider_PreviewMouseUp"
                            LostMouseCapture="MediaSeekSlider_LostMouseCapture"
                            ValueChanged="MediaSeekSlider_ValueChanged" />
                    <TextBlock x:Name="MediaTimeText" Grid.Column="2" Style="{StaticResource Caption}" FontSize="11"
                               VerticalAlignment="Center" Text="0:00 / 0:00" MinWidth="80" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    <Slider x:Name="MediaVolumeSlider" Grid.Column="4" Style="{StaticResource MediaSeekSlider}"
                            Width="90" Margin="8,0,0,0" Minimum="0" Maximum="1"
                            Value="1" VerticalAlignment="Center" ValueChanged="MediaVolumeSlider_ValueChanged" />
                    <TextBlock x:Name="MediaVolumeText" Grid.Column="5" Style="{StaticResource Caption}" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="32" Text="100%" />
                </Grid>
            </Border>
        </Grid>

        <!-- Brief confirmations that do not need a click. -->
        <Border x:Name="ToastHost" Grid.ColumnSpan="2" Visibility="Collapsed" VerticalAlignment="Bottom"
                HorizontalAlignment="Center" Margin="0,0,0,22" Background="{StaticResource Bg3}"
                BorderBrush="#3A424E" BorderThickness="1" CornerRadius="8" Padding="13,8">
            <TextBlock x:Name="ToastText" FontSize="13" Foreground="{StaticResource Text}" />
        </Border>
    </Grid>
</UserControl>
