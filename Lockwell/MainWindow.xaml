<Window x:Class="Lockwell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lockwell" Height="760" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource UiFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowShell" Background="{StaticResource WindowBg}" BorderBrush="{StaticResource Stroke}"
            BorderThickness="1" CornerRadius="12">
        <Grid ClipToBounds="True">
            <!-- Ambient corner glows -->
            <Border Width="640" Height="640" Background="{StaticResource GlowViolet}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-260,-220,0" IsHitTestVisible="False" />
            <Border Width="620" Height="620" Background="{StaticResource GlowTeal}"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="-240,0,0,-260" IsHitTestVisible="False" />

            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#40000000">
                <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource GlassBg}"
                            BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Lockwell" Margin="10,0,0,0" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                    <Border x:Name="LockedPill" Margin="12,0,0,0" CornerRadius="8" Padding="10,3"
                            Background="{StaticResource GlassBg}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="LockedPillText" Text="Locked" FontSize="11" Foreground="{StaticResource Muted}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="LockNowButton" Style="{StaticResource IconButton}" Content="&#xE72E;"
                            ToolTip="Lock now" Click="LockNowButton_Click" Visibility="Collapsed" />
                    <Button x:Name="MinButton" Style="{StaticResource IconButton}" Content="&#xE921;"
                            ToolTip="Minimize" Click="MinButton_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource IconButton}" Content="&#xE922;"
                            ToolTip="Maximize" Click="MaxButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            ToolTip="Close" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Navigation host -->
            <ContentControl x:Name="Host" Grid.Row="1" />
            </Grid>
        </Grid>
    </Border>
</Window>
