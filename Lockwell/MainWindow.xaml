<Window x:Class="Lockwell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lockwell" Height="760" Width="1180"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource UiFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowShell" Background="{StaticResource Bg0}" BorderBrush="{StaticResource Stroke}"
            BorderThickness="1" CornerRadius="10">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar: only what Windows needs. The app's name is already on the taskbar. -->
            <Grid Grid.Row="0" Background="{StaticResource Bg1}">
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <Image Source="/Lockwell;component/Assets/lockwell-icon-source.png" Width="15" Height="15"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Text="Lockwell" Margin="8,0,0,0" FontSize="12"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinButton" Style="{StaticResource ChromeButton}" Content="&#xE921;"
                            ToolTip="Minimize" Click="MinButton_Click" />
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;"
                            ToolTip="Maximize" Click="MaxButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            ToolTip="Close" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Navigation host -->
            <ContentControl x:Name="Host" Grid.Row="1" IsTabStop="False" />
        </Grid>
    </Border>
</Window>
